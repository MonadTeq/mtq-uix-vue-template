# Documentation: https://editorconfig.org (restart the editor after modifying the configuration)

## Tell the EditorConfig plugin that this is the root file
root = true

## Applies to all files
[*]
### Set the charset
charset = utf-8
### Indent style space | tab, space is recommended
indent_style = space
### Number of spaces to indent
indent_size = 2
### Line ending type lf | cr | crlf, usually set to lf
end_of_line = lf
### Whether to insert a blank line at the end of the file
insert_final_newline = true
### Whether to trim leading and trailing spaces in a line
trim_trailing_whitespace = true

## Applies to .md files
[*.md]
insert_final_newline = false
trim_trailing_whitespace = false
