/**
 * @link https://www.typescriptlang.org/tsconfig
 * @link https://cn.vuejs.org/guide/typescript/overview#configuring-tsconfig-json
 * @link https://cn.vite.dev/guide/features#typescript-compiler-options
 */

{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["esnext", "dom"],
    "useDefineForClassFields": true,
    "experimentalDecorators": true,
    // baseUrl tells the compiler where to look for modules; this must be configured when using non-relative modules
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    // Path mapping configuration for non-relative module imports; paths are calculated based on the baseUrl configuration, kept in sync with the alias configuration in vite.config
    "paths": {
      "@/*": ["src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "element-plus/global"],
    // Allow importing files with .ts .mts .tsx extensions
    "allowImportingTsExtensions": true,
    // Allow JS
    "allowJs": true,
    // TS strict mode
    "strict": true,
    "importHelpers": true,
    // Do not output any compiled files; only perform type checking
    "noEmit": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // List of files to be compiled
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "**/*.d.ts"],
  // List of files to exclude from compilation
  "exclude": ["node_modules", "dist"]
}
