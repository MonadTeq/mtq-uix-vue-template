# Environment variables for the production environment (names must start with VITE_)

## Backend API address (if CORS is used to solve cross-origin issues, an absolute path is required)
VITE_BASE_URL = https://apifoxmock.com/m1/2930465-2145633-default/api/v1

## Public path of static assets during build (for example, when deploying to https://un-pany.github.io/v3-admin-vite/, fill in /v3-admin-vite/)
VITE_PUBLIC_PATH = /v3-admin-vite/
